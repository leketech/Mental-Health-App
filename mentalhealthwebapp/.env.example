# Environment Variables for UnwindMind Backend

# Server Configuration
PORT=10000

# Database Configuration (Automatically set by Render)
DB_CONNECTION_STRING=postgres://username:password@host:port/database

# JWT Configuration (Automatically generated by Render)
JWT_SECRET=your-super-secret-jwt-key-here

# OpenAI API Configuration (Required - Set manually)
OPENAI_API_KEY=sk-your-openai-api-key-here

# CORS Configuration (Automatically set by Render)
CORS_ORIGIN=https://unwindmind.life